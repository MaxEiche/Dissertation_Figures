# ============================
# Global Matplotlib style for thesis figures
# ============================

# ===== FIGURE & SAVE =====
# Physical size: full text width in Word (~16 cm ≈ 6.3 in)
figure.figsize        : 6.3, 4.0    # width x height in inches
figure.dpi            : 150         # interactive / on-screen
savefig.dpi           : 300         # export quality
savefig.format        : svg         # default export format if no extension given
savefig.bbox          : tight
savefig.pad_inches    : 0.02
savefig.transparent   : True        # white background from Word, not from figure

# ===== FONTS =====
font.family           : Arial
font.size             : 8           # base size for general text

# Axis titles and labels
axes.titlesize        : 10
axes.labelsize        : 9

# Ticks and legend
xtick.labelsize       : 8
ytick.labelsize       : 8
legend.fontsize       : 7.5
legend.title_fontsize : 7.5

# ===== AXES & LINES =====
axes.linewidth        : 0.8
axes.edgecolor        : 0.1, 0.1, 0.1
axes.grid             : False

lines.linewidth       : 1.3
lines.markersize      : 4
lines.markeredgewidth : 0.7

# ===== TICKS =====
xtick.direction       : out
ytick.direction       : out

xtick.major.size      : 3
ytick.major.size      : 3
xtick.minor.size      : 1.5
ytick.minor.size      : 1.5

xtick.major.width     : 0.8
ytick.major.width     : 0.8
xtick.minor.width     : 0.6
ytick.minor.width     : 0.6

# ===== LAYOUT =====
figure.autolayout                : False
figure.constrained_layout.use    : True
figure.constrained_layout.w_pad  : 0.02
figure.constrained_layout.h_pad  : 0.02

# ==============================
# Error bar styling (global)
# ==============================
errorbar.capsize                 : 3
